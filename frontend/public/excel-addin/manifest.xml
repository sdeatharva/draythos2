  <AppDomains>
    <AppDomain>http://localhost:8000</AppDomain>
    <AppDomain>http://localhost:8001</AppDomain>
    <AppDomain>http://localhost:3000</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Workbook" />
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/excel-addin/index.html" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>

