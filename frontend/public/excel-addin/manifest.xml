  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:type="TaskPaneApp">
  <Id>6b7f3290-7815-4a62-b912-d9c490e55092</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Draythos</ProviderName>
